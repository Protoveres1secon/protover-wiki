 function detailMarkup(node){
+  if(node.id==="errol"){
+    return errolProfileMarkup();
+  }
+
+  const sections = (node.sections||[]).map(([title,text]) =>
+    `<div class="subCard"><b>${escapeHtml(title)}</b><p>${escapeHtml(text)}</p></div>`
+  ).join("");
+
+  return `
+    <div class="detailTop">
+      <div>
+        <div class="eyebrow">${escapeHtml(node.type || "content").toUpperCase()}</div>
+        <h2 style="margin:8px 0 0;font-size:28px">${escapeHtml(node.title || node.label)}</h2>
+      </div>
+      <div class="detailIcon">${escapeHtml(node.icon || "🌌")}</div>
+    </div>
+    <div class="tagRow">${(node.tags||[]).map(t=>`<span class="tag">${escapeHtml(t)}</span>`).join("")}</div>
+    <div class="detailText">${escapeHtml(node.summary || "")}</div>
+    ${sections ? `<div class="subGrid">${sections}</div>` : ""}
+    ${(node.children||[]).length
+      ? `<div class="quote">↘️ Nhánh con: ${(node.children||[]).map(c=>escapeHtml(c.label)).join(" • ")}</div>`
+      : `<div class="notice">📌 Đây là một lá cuối của cây. Khi muốn mở rộng, thêm <b>children</b> hoặc <b>sections</b> vào node này.</div>`
+    }
+  `;
+}
