rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;

      match /friendRequests/{requestUid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == requestUid;
        allow delete: if request.auth != null && (request.auth.uid == uid || request.auth.uid == requestUid);
      }

      match /friends/{friendUid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update, delete:
          if request.auth != null && (request.auth.uid == uid || request.auth.uid == friendUid);
      }
    }



    match /posts/{postId} {
      allow read: if request.auth != null
        && (resource.data.visibility == 'public' || resource.data.ownerUid == request.auth.uid);

      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.visibility in ['public', 'private']
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && request.resource.data.imageData is string
        && request.resource.data.imageData.size() <= 950000;

      allow update, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;

      match /reactions/{uid} {
        allow read: if request.auth != null;
        allow create, update, delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /chats/{chatId}/messages/{messageId} {
      allow read: if request.auth != null
        && chatId.split('__').hasAny([request.auth.uid]);

      allow create: if request.auth != null
        && chatId.split('__').hasAny([request.auth.uid])
        && request.resource.data.senderUid == request.auth.uid;

      allow update: if request.auth != null
        && chatId.split('__').hasAny([request.auth.uid])
        && resource.data.senderUid == request.auth.uid
        && request.resource.data.senderUid == resource.data.senderUid;
    }
  }
}
