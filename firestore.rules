rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;

      match /friendRequests/{requestUid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == requestUid;
        allow delete: if request.auth != null && (request.auth.uid == uid || request.auth.uid == requestUid);
      }

      match /friends/{friendUid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update, delete:
          if request.auth != null && (request.auth.uid == uid || request.auth.uid == friendUid);
      }

      // Activity notifications owned by the recipient.
      // The sender may create a notification for another user; only the
      // recipient can read, mark read, or delete it.
      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create:
          if request.auth != null
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.type is string;
        allow update, delete:
          if request.auth != null && request.auth.uid == uid;
      }
    }

    match /chats/{chatId}/messages/{messageId} {
      allow read:
        if request.auth != null
        && chatId.split('__').hasAny([request.auth.uid]);

      allow create:
        if request.auth != null
        && chatId.split('__').hasAny([request.auth.uid])
        && request.resource.data.senderUid == request.auth.uid;

      allow update:
        if request.auth != null
        && chatId.split('__').hasAny([request.auth.uid])
        && resource.data.senderUid == request.auth.uid
        && request.resource.data.senderUid == resource.data.senderUid;
    }

    // Protoveres Social Posts
    match /posts/{postId} {
      // Public posts: every signed-in member can read, even without being friends.
      // Private posts: only the owner can read.
      allow read:
        if request.auth != null
        && (
          resource.data.visibility == 'public'
          || resource.data.ownerUid == request.auth.uid
        );

      // A signed-in member may create a post only for their own UID.
      // We deliberately keep validation light here so image/text variants
      // are not rejected by an overly strict rule.
      allow create:
        if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.visibility in ['public', 'private'];

      // Only the author may modify or remove their own post.
      allow update, delete:
        if request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      match /reactions/{reactionId} {
        allow read: if request.auth != null;

        allow create:
          if request.auth != null
          && request.resource.data.uid == request.auth.uid;

        allow update, delete:
          if request.auth != null
          && resource.data.uid == request.auth.uid;
      }
    }
  }
}
