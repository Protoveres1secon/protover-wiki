rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public member profiles: any signed-in user may read,
    // but only the owner may create/update/delete their own profile.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;

      // Friend requests: sender writes using their own UID as the document ID;
      // recipient manages requests in their own inbox.
      match /friendRequests/{requestUid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == requestUid;
        allow delete: if request.auth != null && (request.auth.uid == uid || request.auth.uid == requestUid);
      }

      // Each side of a friendship is stored under its owner's UID.
      match /friends/{friendUid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update, delete: if request.auth != null && (request.auth.uid == uid || request.auth.uid == friendUid);
      }
    }

    // 1-to-1 chats. The chat ID is the two UIDs sorted and joined with "__".
    match /chats/{chatId}/messages/{messageId} {
      allow read: if request.auth != null && chatId.split('__').hasAny([request.auth.uid]);
      allow create: if request.auth != null
                    && chatId.split('__').hasAny([request.auth.uid])
                    && request.resource.data.senderUid == request.auth.uid;
    }
  }
}
