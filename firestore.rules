rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // USER PROFILES
    // =========================
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update, delete:
        if request.auth != null && request.auth.uid == uid;

      match /friendRequests/{requestUid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create:
          if request.auth != null && request.auth.uid == requestUid;
        allow delete:
          if request.auth != null
          && (request.auth.uid == uid || request.auth.uid == requestUid);
      }

      match /friends/{friendUid} {
        allow read:
          if request.auth != null && request.auth.uid == uid;
        allow create, update, delete:
          if request.auth != null
          && (request.auth.uid == uid || request.auth.uid == friendUid);
      }
    }

    // =========================
    // 1-TO-1 CHAT
    // =========================
    match /chats/{chatId}/messages/{messageId} {
      allow read:
        if request.auth != null
        && chatId.split('__').hasAny([request.auth.uid]);

      allow create:
        if request.auth != null
        && chatId.split('__').hasAny([request.auth.uid])
        && request.resource.data.senderUid == request.auth.uid;

      allow update:
        if request.auth != null
        && chatId.split('__').hasAny([request.auth.uid])
        && resource.data.senderUid == request.auth.uid
        && request.resource.data.senderUid == resource.data.senderUid;
    }

    // =========================
    // SOCIAL POSTS
    // =========================
    match /posts/{postId} {
      // Authenticated users can read public posts;
      // owners can also read their own private posts.
      allow read:
        if request.auth != null
        && (
          resource.data.visibility == 'public'
          || resource.data.ownerUid == request.auth.uid
        );

      // Only create a post owned by the currently signed-in user.
      allow create:
        if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.visibility in ['public', 'private']
        && request.resource.data.text is string
        && request.resource.data.mediaType in [null, 'image'];

      // Keep post ownership fixed. Only owner may edit/delete their post.
      allow update, delete:
        if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;

      match /reactions/{reactionId} {
        allow read: if request.auth != null;

        allow create, update:
          if request.auth != null
          && reactionId == request.auth.uid + '_' + request.resource.data.type
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.type in ['like', 'heart'];

        allow delete:
          if request.auth != null
          && resource.data.uid == request.auth.uid;
      }
    }
  }
}
